---
interface Props {
  /** The glyph: up-right arrow instead of the right arrow. */
  diagonal?: boolean;
  /**
   * The hover roll direction (`--roll-out` / `--roll-in`). Defaults to `diagonal`.
   * The original site's LinkCircle always pairs the up-right glyph with the flat
   * (horizontal) roll — `/studio` and every other `.linkcircle` in the recovered
   * pages render `class="arrow-roll"` with the diagonal path — so callers can ask
   * for the glyph without the modifier. `refrow__ext` keeps the diagonal roll.
   */
  diagonalRoll?: boolean;
  class?: string;
}

const { diagonal = false, diagonalRoll = diagonal, class: className = '' } = Astro.props;
---

<span
  class:list={['arrow-roll', diagonalRoll && 'arrow-roll--diagonal', className]}
  aria-hidden="true"
>
  <span class="arrow-roll__icon arrow-roll__current">
    {diagonal ? (
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none">
        <path
          d="M18.25 15.25V5.75M18.25 5.75H8.75M18.25 5.75L6 18"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    ) : (
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none">
        <path
          d="M14 5.75L20.25 12L14 18.25"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          d="M19.5 12H3.75"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    )}
  </span>
  <span class="arrow-roll__icon arrow-roll__next">
    {diagonal ? (
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none">
        <path
          d="M18.25 15.25V5.75M18.25 5.75H8.75M18.25 5.75L6 18"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    ) : (
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none">
        <path
          d="M14 5.75L20.25 12L14 18.25"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          d="M19.5 12H3.75"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    )}
  </span>
</span>
