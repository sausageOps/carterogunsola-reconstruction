---
interface Props {
  href?: string;
  size?: 'sm' | 'md' | 'lg';
  variant?: 'default' | 'surface' | 'ghost';
  label?: string;
  class?: string;
  [key: string]: any;
}

const {
  href,
  size = 'md',
  variant = 'default',
  label = 'Close',
  class: className = '',
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  type={!href ? 'button' : undefined}
  aria-label={label}
  class:list={[
    'closebox',
    size !== 'md' && `closebox--${size}`,
    variant !== 'default' && `closebox--${variant}`,
    className,
  ]}
  {...rest}
>
  <slot>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </slot>
</Tag>
