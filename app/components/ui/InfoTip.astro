---
interface Props {
  title: string;
  place?: 'top' | 'bottom';
  label?: string;
  class?: string;
}

const {
  title,
  place = 'top',
  label = 'Stage controls',
  class: className = '',
} = Astro.props;
---

<div class:list={['infotip', className]} data-place={place}>
  <button type="button" class="stage-ibtn infotip__btn" aria-label={label}>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="12" cy="12" r="9.25" stroke="currentColor" stroke-width="1.5" />
      <path d="M12 11.25v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      <circle cx="12" cy="8" r="1" fill="currentColor" />
    </svg>
  </button>
  <div class="infotip__tip" role="tooltip">
    <span class="infotip__title text-mono-meta">{title}</span>
    <slot />
  </div>
</div>
