---
interface Props {
  title: string;
  place?: 'top' | 'bottom';
  label?: string;
  class?: string;
  /** Renders the trigger as an external link instead of a button (the /studio variant). */
  href?: string;
  target?: string;
  rel?: string;
  /** `id` for the tooltip, wired to the trigger's `aria-describedby`. */
  tipId?: string;
  /** The recovered /studio tooltip titles "balky.studio" in an uppercase `<p class="text-label">`. */
  titleTag?: 'span' | 'p';
  titleClass?: string;
  /** Trailing arrow-up-right glyph, used when the tip names an external destination. */
  externalIcon?: boolean;
}

const {
  title,
  place = 'top',
  label = 'Stage controls',
  class: className = '',
  href,
  target = '_blank',
  rel = 'noopener noreferrer',
  tipId,
  titleTag = 'span',
  titleClass = 'text-mono-meta',
  externalIcon = false,
} = Astro.props;
---

<div class:list={['infotip', className]} data-place={place}>
  {href ? (
    <a
      class="stage-ibtn infotip__btn"
      href={href}
      target={target}
      rel={rel}
      aria-label={label}
      aria-describedby={tipId}
      data-hover
    >
      <svg width="1em" height="1em" aria-hidden="true" data-icon="circle-info">
        <use href="#ai:local:circle-info"></use>
      </svg>
    </a>
  ) : (
    <button
      type="button"
      class="stage-ibtn infotip__btn"
      aria-label={label}
      aria-describedby={tipId}
    >
      <svg width="1em" height="1em" aria-hidden="true" data-icon="circle-info">
        <use href="#ai:local:circle-info"></use>
      </svg>
    </button>
  )}
  <div class="infotip__tip" id={tipId} role="tooltip">
    {titleTag === 'p' ? (
      <p class:list={['infotip__title', titleClass]}>
        {title}
        {externalIcon && (
          <svg width="1em" height="1em" aria-hidden="true" data-icon="arrow-up-right">
            <use href="#ai:local:arrow-up-right"></use>
          </svg>
        )}
      </p>
    ) : (
      <span class:list={['infotip__title', titleClass]}>
        {title}
        {externalIcon && (
          <svg width="1em" height="1em" aria-hidden="true" data-icon="arrow-up-right">
            <use href="#ai:local:arrow-up-right"></use>
          </svg>
        )}
      </span>
    )}
    <slot />
  </div>
</div>
