---
import Socials from './ui/Socials.astro';
import { NAV_ITEMS, SITE } from '../data/site';
---

<div
  class="drawer"
  id="drawer"
  data-drawer
  aria-hidden="true"
  data-astro-transition-persist="astro-gyrtbwwo-9"
>
  <div class="drawer__sheet" data-drawer-sheet role="dialog" aria-modal="true" aria-label="Menu">
    <span class="drawer__handle" aria-hidden="true"></span>
    <nav class="drawer__nav" aria-label="Mobile">
      {NAV_ITEMS.map((item) => (
        <a href={item.href} class="drawer__link" data-drawer-link>{item.label}</a>
      ))}
    </nav>
    <div class="drawer__meta">
      <div class="drawer__hud text-hud">
        <span class="drawer__chip">
          <span class="drawer__k">UT::</span><span class="drawer__v" data-hud-time>--:--</span>
        </span>
        <span class="drawer__chip">
          <span class="drawer__k">FPS::</span><span class="drawer__v" data-hud-fps>--</span>
        </span>
        <span class="drawer__chip">
          <span class="drawer__k">{SITE.hud.bookingLabel}::</span><span class="drawer__v">{SITE.hud.nextOpen}</span>
        </span>
      </div>
      <Socials />
    </div>
  </div>
</div>
