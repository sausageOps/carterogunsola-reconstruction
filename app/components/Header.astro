---
import Logo from './Logo.astro';
import { NAV_ITEMS, SITE, getLogoWordForPath } from '../data/site';

interface Props {
  crumbName?: string;
}

const { crumbName } = Astro.props;
const pathname = Astro.url.pathname;
const logoWord = getLogoWordForPath(pathname);
---

<header class="header" data-header data-astro-transition-persist="astro-gyrtbwwo-5">
  <div class="hud" aria-hidden="true">
    <span class="hud__chip text-hud">
      <span class="hud__k">UT::</span><span class="hud__v" data-hud-time>--:--</span>
    </span>
    <span class="hud__chip text-hud">
      <span class="hud__k">FPS::</span><span class="hud__v" data-hud-fps>--</span>
    </span>
    <span class="hud__chip text-hud" data-hud-online-chip hidden>
      <span class="hud__k">ONLINE::</span>
      <number-flow class="hud__v" data-hud-online>--</number-flow>
    </span>
    <span class="hud__chip text-hud" data-hud-lcp-chip hidden>
      <span class="hud__k">LCP::</span><span class="hud__v" data-hud-lcp>--</span>
    </span>
    <span class="hud__chip text-hud" data-hud-owner-chip hidden>
      <span class="hud__k">CARTER::</span><span class="hud__v">HERE</span>
    </span>
    <button
      type="button"
      class="hud__chip text-hud"
      data-hud-presence
      tabindex="-1"
      aria-pressed="true"
      aria-label="Toggle live presence"
    >
      <span class="hud__k">PRESENCE::</span><span class="hud__v" data-hud-presence-v>ON</span>
    </button>
    <span class="hud__chip text-hud" data-hud-listening-chip hidden>
      <span class="hud__k">LISTENING::</span><span class="hud__v hud__v--trunc" data-hud-listening></span>
    </span>
    <span class="hud__chip text-hud">
      <span class="hud__k">{SITE.hud.bookingLabel}::</span><span class="hud__v">{SITE.hud.nextOpen}</span>
    </span>
  </div>

  <div class="header__bar">
    <div class="header__lead">
      <a href="/" class="header__logo" aria-label="Carter Ogunsola — home">
        <Logo word={logoWord} />
      </a>
      <span class="header__crumb" data-crumb hidden={!crumbName}>
        <span class="header__crumb-sep" aria-hidden="true">::</span>
        <span class="header__crumb-name text-nav" data-crumb-name></span>
      </span>
    </div>

    <div class="header__center">
      <nav class="navpill" aria-label="Primary">
        <span class="navpill__pill" data-nav-pill aria-hidden="true"></span>
        <ul class="navpill__list">
          {NAV_ITEMS.map((item) => (
            <li>
              <a href={item.href} class="navpill__link text-nav" aria-label={item.label}>
                <span class="roll" data-roll aria-hidden="true">{item.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <button
        type="button"
        class="cmdk"
        data-cmd-open
        data-magnetic="0.15"
        aria-label="Open command menu"
        aria-keyshortcuts="Meta+K"
      >
        <span class="cmdk__label roll text-nav" data-roll aria-hidden="true">⌘K</span>
      </button>
    </div>

    <div class="header__right">
      <button
        type="button"
        class="notifbell"
        data-notif-open
        aria-label="What’s new"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="notif"
      >
        <span class="notifbell__icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none">
            <path d="M4.47254 9.40225C4.94336 5.60292 8.17163 2.75 12 2.75C15.8284 2.75 19.0567 5.60291 19.5275 9.40224L20.2217 15.004C20.3695 16.1971 19.439 17.25 18.2369 17.25H5.76317C4.56102 17.25 3.63051 16.1971 3.77835 15.004L4.47254 9.40225Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M16 17.25C16 19.4591 14.2091 21.25 12 21.25C9.79086 21.25 8 19.4591 8 17.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="notifbell__badge" data-notif-dot data-open="false" hidden aria-hidden="true">
          <span class="notifbell__dot"></span>
        </span>
      </button>

      <button
        type="button"
        class="navsearch"
        data-cmd-open
        aria-label="Search"
        aria-keyshortcuts="Meta+K"
      >
        <svg class="navsearch__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <use href="#ai:local:magnifying-glass"></use>
        </svg>
      </button>

      <div class="themetoggle" role="group" aria-label="Theme" data-theme-toggle>
        <button
          type="button"
          class="themetoggle__seg"
          data-theme-set="light"
          aria-label="Light theme"
          aria-pressed="true"
        >
          <span class="themetoggle__bg" data-theme-bg aria-hidden="true"></span>
          <svg class="themetoggle__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <use href="#ai:local:sun"></use>
          </svg>
        </button>
        <button
          type="button"
          class="themetoggle__seg"
          data-theme-set="dark"
          aria-label="Dark theme"
          aria-pressed="false"
        >
          <svg class="themetoggle__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <use href="#ai:local:moon"></use>
          </svg>
        </button>
      </div>

      <button
        type="button"
        class="navtrigger"
        data-drawer-open
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="drawer"
      >
        <span class="navtrigger__bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>
