---
import LinkCircle from './ui/LinkCircle.astro';
import { CHANGELOG_ITEMS } from '../data/site';

/** Original server-rendered label: short month + day, no leading zero (e.g. `Oct 2`). */
const timeLabel = (date: string) =>
  new Date(`${date}T00:00:00Z`).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
const isExternal = (href?: string) => Boolean(href && href.startsWith('http'));
---

<div
  class="notif"
  id="notif"
  data-notif
  aria-hidden="true"
  data-astro-transition-persist="astro-gyrtbwwo-8"
>
  <div class="notif__panel" role="dialog" aria-modal="true" aria-label="What’s new">
    <div class="notif__head">
      <p class="notif__title text-label">What’s new</p>
      <span class="notif__count text-meta" data-notif-count hidden></span>
      <button type="button" class="notif__clear text-meta" data-notif-clear hidden>
        Mark all read
      </button>
    </div>
    <div class="notif__body">
      <div class="notif__fade" aria-hidden="true"></div>
      <div class="notif__list" data-notif-list data-lenis-prevent>
        {CHANGELOG_ITEMS.map((item) => (
          item.href ? (
            <a
              href={item.href}
              target={isExternal(item.href) ? '_blank' : undefined}
              rel={isExternal(item.href) ? 'noopener noreferrer' : undefined}
              class="notif__item notif__item--link"
              data-date={item.date}
              data-hover
            >
              <div class="notif__main">
                <div class="notif__meta">
                  <span class="chip chip--pill text-meta">{item.tag}</span>
                  <span class="notif__time text-meta" data-time={item.date}>{timeLabel(item.date)}</span>
                </div>
                <p class="notif__label text-tag">{item.title}</p>
                <p class="notif__summary">{item.summary}</p>
              </div>
              <span class="notif__dot" aria-hidden="true"></span>
              <LinkCircle diagonal diagonalRoll={false} class="notif__link" />
            </a>
          ) : (
            <div class="notif__item" data-date={item.date}>
              <div class="notif__main">
                <div class="notif__meta">
                  <span class="chip chip--pill text-meta">{item.tag}</span>
                  <span class="notif__time text-meta" data-time={item.date}>{timeLabel(item.date)}</span>
                </div>
                <p class="notif__label text-tag">{item.title}</p>
                <p class="notif__summary">{item.summary}</p>
              </div>
              <span class="notif__dot" aria-hidden="true"></span>
            </div>
          )
        ))}
      </div>
      <div class="notif__fade notif__fade--bottom" aria-hidden="true"></div>
    </div>
    <div class="notif__footer">
      <a href="/changelog" class="notif__all text-meta" data-hover>
        View all
        <svg class="notif__all-arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <use href="#ai:local:arrow-right"></use>
        </svg>
      </a>
    </div>
  </div>
</div>
