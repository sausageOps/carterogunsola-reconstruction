---
import { getLogoWordForPath } from '../data/site';

interface Props {
  word?: string;
  isVeilWord?: boolean;
  class?: string;
}

const {
  word = getLogoWordForPath(Astro.url.pathname),
  isVeilWord = false,
  class: className = '',
} = Astro.props;

const isSingle = word.length <= 1;
---

<span
  class:list={['logo', className]}
  aria-hidden="true"
  data-veil-word={isVeilWord ? '' : undefined}
>
  <svg
    class="logo__shape logo__circle"
    viewBox="0 0 88 88"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <path
      d="M44.365 65C33.151 65 26 57.62 26 44s7.151-21 18.365-21c9.654 0 16.587 5.74 17.635 14.35h-8.57c-.891-4.62-4.249-7.21-9.065-7.21-6.501 0-9.961 4.62-9.961 13.86s3.46 13.86 9.961 13.86c4.816 0 8.174-2.59 9.065-7.21H62C60.952 59.26 54.019 65 44.365 65Z"
      fill="var(--logo-fg)"
    ></path>
  </svg>
  <span class:list={['logo__shape', 'logo__capsule', isSingle && 'logo__capsule--single']}>
    <span class="logo__word">{word}</span>
  </span>
</span>
