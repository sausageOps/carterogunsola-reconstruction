---
import { getLogoWordForPath } from '../data/site';

interface Props {
  word?: string;
  isVeilWord?: boolean;
  class?: string;
}

const {
  word = getLogoWordForPath(Astro.url.pathname),
  isVeilWord = false,
  class: className = '',
} = Astro.props;

const isSingle = word.length <= 1;
---

<span
  class:list={['logo', className]}
  aria-hidden="true"
  data-veil-word={isVeilWord ? '' : undefined}
>
  <span class="logo__shape logo__circle">C</span>
  <span class:list={['logo__shape', 'logo__capsule', isSingle && 'logo__capsule--single']}>
    <span class="logo__word">{word}</span>
  </span>
</span>
