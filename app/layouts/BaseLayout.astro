---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.scss';
import '../styles/scroll-rail.css';
import SvgSymbols from '../components/SvgSymbols.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CommandMenu from '../components/CommandMenu.astro';
import Notifications from '../components/Notifications.astro';
import Drawer from '../components/Drawer.astro';
import Veil from '../components/Veil.astro';
import { SITE } from '../data/site';
import { ORIGINAL_SITE_JSONLD } from '../data/original-jsonld';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** `og:type` — `website` everywhere, `article` on writing posts (original head). */
  ogType?: string;
  /** Optional route-specific head overrides; defaults retain the shared foundation. */
  canonical?: string;
  jsonLd?: Record<string, any>;
  crumbName?: string;
  showFooter?: boolean;
  noindex?: boolean;
  /** `null` (default) omits the robots meta — the captured originals only carry it on /record. */
  robots?: string | null;
  mainClass?: string;
  mainAttrs?: Record<string, any>;
}

const {
  title,
  description = SITE.description,
  ogImage = SITE.ogImage,
  ogType = 'website',
  canonical,
  jsonLd: jsonLdOverride,
  crumbName,
  showFooter = true,
  noindex = false,
  robots: robotsOverride = null,
  mainClass = '',
  mainAttrs = {},
} = Astro.props;

const fullTitle = title
  ? `${title}${SITE.titleSeparator}${SITE.name}`
  : `${SITE.name}${SITE.titleSeparator}${SITE.role}`;
const robotsContent = noindex ? 'noindex, nofollow' : robotsOverride;

const pathname = Astro.url.pathname;
// The originals carry extension-less canonical/og:url values without a trailing slash
// (`https://carterogunsola.com/about`); only the root keeps its `/`.
const trimSlash = (url: string) => (url === `${SITE.url}/` ? url : url.replace(/\/+$/, ''));
const canonicalUrl = trimSlash(canonical ?? new URL(pathname, SITE.url).toString());
const ogImageUrl = ogImage.startsWith('http')
  ? ogImage
  : `${SITE.ogOrigin}${ogImage}`;

const jsonLd = jsonLdOverride ?? ORIGINAL_SITE_JSONLD;

---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    {robotsContent && <meta name="robots" content={robotsContent} />}
    <meta name="theme-color" content="#d6d6d5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1e1e1e" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Carter Ogunsola :: Writing"
      href={`${SITE.url}/rss.xml`}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Carter Ogunsola :: Ship log"
      href={`${SITE.url}/changelog.xml`}
    />
    <link
      rel="alternate"
      type="application/feed+json"
      title="Carter Ogunsola :: Ship log"
      href={`${SITE.url}/feed.json`}
    />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.ogLocale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.twitterHandle} />
    <meta name="twitter:creator" content={SITE.twitterHandle} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        // One-shot theme-cutover migration (2026-08-27, the dark-default switch):
        // visitors from the follow-OS era keep what they were seeing. Evidence of a
        // past visit = any first-party key already stored; those browsers get
        // "system" stamped (their old behavior, made explicit). The marker makes
        // this run EXACTLY once per browser. Storage-less past visitors are
        // indistinguishable from new ones and get the dark default.
        try {
          if (!localStorage.getItem('theme') && !localStorage.getItem('theme-cutover')) {
            localStorage.setItem('theme-cutover', '1');
            var legacy = ['notif-seen', 'lab-mode', 'presence', 'owner-key', 'assets_key'];
            if (
              legacy.some(function (k) {
                return localStorage.getItem(k) !== null;
              })
            )
              localStorage.setItem('theme', 'system');
          }
        } catch (e) {}
        function resolve() {
          try {
            var stored = localStorage.getItem('theme');
            if (stored === 'light' || stored === 'dark') return stored;
            if (stored === 'system') {
              return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
          } catch (e) {}
          return 'dark';
        }
        // Point the svg favicon at the variant that matches the SITE theme.
        // Explicit "light"/"dark" → fixed favicon-<theme>.svg (tracks the site, not
        // the OS). Explicit "system" → the adaptive favicon.svg (its own
        // prefers-color-scheme media query). No stored choice → the fixed dark
        // favicon (the house default).
        function syncFavicon() {
          var link = document.querySelector('link[rel="icon"][type="image/svg+xml"]');
          if (!link) return;
          var t = null;
          try {
            t = localStorage.getItem('theme');
          } catch (e) {}
          var href =
            t === 'light' || t === 'dark'
              ? '/favicon-' + t + '.svg'
              : t === 'system'
                ? '/favicon.svg'
                : '/favicon-dark.svg';
          if (link.getAttribute('href') !== href) link.setAttribute('href', href);
        }
        window.__syncFavicon = syncFavicon;
        // "Bare" mode — when a page is framed by /record with ?bare=1, strip the
        // site chrome; docs=0 / cfg=0 additionally hide the lab scaffold's Docs
        // toggle / Tune gear. Applied pre-paint to avoid a chrome flash.
        function applyBare(target) {
          var q = new URLSearchParams(location.search);
          var bare = q.has('bare');
          target.toggleAttribute('data-bare', bare);
          target.toggleAttribute('data-bare-nodocs', bare && q.get('docs') === '0');
          target.toggleAttribute('data-bare-nocfg', bare && q.get('cfg') === '0');
        }
        root.dataset.theme = resolve();
        syncFavicon();
        applyBare(root);
        document.addEventListener('astro:before-swap', function (e) {
          var next = e.newDocument.documentElement;
          next.dataset.theme = root.dataset.theme || resolve();
          if (root.hasAttribute('data-paper-gl')) next.setAttribute('data-paper-gl', '');
          root.classList.forEach(function (c) {
            if (c === 'lenis' || c.indexOf('lenis-') === 0) next.classList.add(c);
          });
          applyBare(next);
        });
        document.addEventListener('astro:after-swap', syncFavicon);
      })();
    </script>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        if (root.hasAttribute('data-bare') || /^\/record(\/|$)/.test(location.pathname)) {
          root.setAttribute('data-veil', 'off');
          return;
        }
        try {
          var seen = sessionStorage.getItem('veil:seen');
          root.setAttribute('data-veil', seen ? 'fast' : 'boot');
          if (!seen) sessionStorage.setItem('veil:seen', '1');
        } catch (e) {
          root.setAttribute('data-veil', 'fast');
        }
      })();
    </script>
    <noscript><style>html[data-veil] .veil{display:none!important}</style></noscript>
    <ClientRouter />
  </head>
  <body>
    <SvgSymbols />
    <canvas
      class="paper-gl"
      data-paper
      data-astro-transition-persist="paper"
      aria-hidden="true"
    ></canvas>
    <div
      class="veil-dim"
      data-veil-dim
      data-astro-transition-persist="veil-dim"
      aria-hidden="true"
    ></div>
    <canvas
      class="shelf-gl"
      style="position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:1;opacity:0;display:block;transition:opacity 0.6s ease, filter 0.7s ease"
      data-shelf
      data-astro-transition-persist="shelf"
      aria-hidden="true"
    ></canvas>
    <canvas
      class="shelf-still"
      style="position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:1;opacity:0;display:block;transition:opacity 0.6s ease"
      data-shelf-still
      data-astro-transition-persist="shelf-still"
      aria-hidden="true"
    ></canvas>
    <canvas
      class="flight-gl"
      style="position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:80;opacity:0;display:block"
      data-flight
      data-astro-transition-persist="flight"
      aria-hidden="true"
    ></canvas>
    <Header crumbName={crumbName} />
    <main id="main" class={mainClass} {...mainAttrs}>
      <slot />
    </main>
    <slot name="afterMain" />
    {showFooter && <Footer />}
    <div
      class="overlay"
      data-overlay
      aria-hidden="true"
      data-astro-transition-persist="astro-gyrtbwwo-6"
    ></div>
    <CommandMenu />
    <Notifications />
    <Drawer />
    <ol
      class="toast"
      data-toaster
      data-lenis-prevent
      aria-live="polite"
      aria-relevant="additions"
      data-astro-transition-persist="astro-gyrtbwwo-10"
    ></ol>
    <nav class="scroll-rail" data-scroll-rail aria-label="Page sections">
      <p class="scroll-rail__count" data-scroll-rail-count aria-hidden="true">(0)</p>
      <div class="scroll-rail__track" data-scroll-rail-track></div>
    </nav>
    <Veil />
    <script>
      import '../lib/runtime';
      import '../lib/scroll-rail';
    </script>
    <!-- Cloudflare Pages Analytics -->
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={'{"token": "b25d28546f67432e92c9cf1c5910ab94"}'}
    ></script>
    <!-- Cloudflare Pages Analytics -->
  </body>
</html>
