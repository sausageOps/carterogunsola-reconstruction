---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/ui/SectionLabel.astro';
import LinkCircle from '../components/ui/LinkCircle.astro';
import { CHANGELOG_ENTRIES } from '../data/changelog';
import '../styles/changelog.css';

const dateLabel = (date: string) =>
  new Date(`${date}T00:00:00Z`).toLocaleDateString('en-US', {
    month: 'short',
    day: '2-digit',
    timeZone: 'UTC',
  });
---

<BaseLayout title="Changelog" description="A running log of what’s new. New experiments, projects, roles and recognition, as they ship." ogImage="/og/section/home.jpg" canonical="https://carterogunsola.com/changelog" mainClass="log container">
  <div class="log__col">
    <header class="log__intro">
      <SectionLabel as="h1" size="lg" mark>Changelog</SectionLabel>
      <p class="text-lead">
        A running log of what’s new around here: experiments, projects, roles, and recognition, as they ship. Follow along in your reader via
        <a class="log__feed" href="/changelog.xml">the feed</a> (or <a class="log__feed" href="/feed.json">JSON</a>).
      </p>
    </header>
    <section class="log__year" aria-label="2026 updates">
      <SectionLabel as="h2" size="lg" mark>2026</SectionLabel>
      <div class="log__card">
        {CHANGELOG_ENTRIES.map((item) => {
          const external = item.href.startsWith('http');
          return (
            <a
              href={item.href}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
              class="row row--link"
              data-hover
              data-log-row
              data-date={item.date}
            >
              <span class="row__label text-tag">{item.title}</span>
              <span class="row__line" aria-hidden="true"></span>
              <span class="row__tags">
                <span class="chip text-meta row__tag">{dateLabel(item.date)}</span>
                <span class="chip text-meta chip--pill row__tag">{item.category}</span>
                <LinkCircle diagonal diagonalRoll={false} class="row__link" />
              </span>
            </a>
          );
        })}
      </div>
    </section>
  </div>
</BaseLayout>
